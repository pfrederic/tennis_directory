{
  "default": {
    "parallel": 1,
    "format": ["html:cucumber-report.html"],
    "formatOptions": { "snippetInterface": "async-await" },
    "paths": ["src/features/**/*.feature"],
    "requireModule": ["tsx/cjs"],
    "require": [
      "src/features/support/**/*.ts",
      "src/features/step_definitions/**/*.ts"
    ],
    "failFast": true
  }
}
