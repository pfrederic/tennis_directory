# Copy to terraform.tfvars (gitignored) and adjust as needed.

aws_region             = "eu-west-3"
project_name           = "tennis-directory"
lightsail_bundle_id    = "small_3_0"
lightsail_blueprint_id = "ubuntu_24_04"
ssh_public_key_path    = "~/.ssh/tennis_directory_lightsail.pub"

# Lock this down to your own IP (e.g. "203.0.113.10/32") once you know it,
# to reduce SSH brute-force surface at zero extra cost.
allowed_ssh_cidr = "0.0.0.0/0"

# domain_name can be the apex or a subdomain (e.g. "app.your-domain.example"),
# must match the domain configured in the Caddyfile. route53_zone_name is
# always the apex domain backing the existing hosted zone in Route53, even
# when domain_name is a subdomain of it.
domain_name       = "your-domain.example"
route53_zone_name = "your-domain.example"
