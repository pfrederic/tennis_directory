# Copy this file to `.env.prod` on the Lightsail instance and fill in real
# values. `.env.prod` is read via `env_file:` by both the `app` and `db`
# services in docker-compose.prod.yml — never commit the real file.

# --- Postgres: read by both the "db" container (official postgres image)
# and the "app" container (src/infra/db/dialect.ts), one source of truth. ---
POSTGRES_USER=produser
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=tennis_directory

# --- App ---
ENV=production
