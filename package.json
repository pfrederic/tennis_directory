{
  "name": "books.fastify",
  "author": "PIF",
  "private": true,
  "version": "1.0.0",
  "description": "benchmark api",
  "engines": {
    "node": ">=22.x"
  },
  "scripts": {
    "build": "rm -Rf build && tsc -p tsconfig.json",
    "start": "yarn db:codegen && env $(cat .env) tsx watch src/server.ts",
    "start:prod": "tsx src/server.ts",
    "migrate:make": "yarn kysely migrate make test",
    "migrate:run": "env $(cat ${ENV_FILE:-.env}) tsx src/scripts/create-db.ts && env $(cat ${ENV_FILE:-.env}) yarn kysely migrate:latest",
    "migrate:seed": "yarn kysely seed:run",
    "db:codegen": "env $(cat .env) tsx src/scripts/generate-db-types.ts",
    "test": "env $(cat .env.test) cucumber-js -c .config/cucumber.json",
    "lint": "eslint -c eslint.config.mjs ./src"
  },
  "dependencies": {
    "dayjs": "^1.11.21",
    "fastify": "^5.7.4",
    "fastify-plugin": "^6.0.0",
    "kysely": "^0.29.3",
    "kysely-ctl": "^0.21.0",
    "pg": "^8.22.0",
    "sqlite": "^5.1.1",
    "tsx": "^4.22.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-chai-friendly": "^1.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write --no-semi --single-quote --trailing-comma all",
      "eslint -c eslint.config.mjs ./src"
    ]
  }
}
